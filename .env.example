# ── App security (REQUIRED) ──────────────────────────────────────────────
# Shared secret the frontend must send as the X-API-Key header on every /api/* call.
# Without it, all API routes reject requests. Generate one, e.g.:  openssl rand -hex 32
APP_API_TOKEN=changeme-generate-a-long-random-token

# Comma-separated list of origins allowed by CORS (no wildcards).
ALLOWED_ORIGINS=http://localhost:8000

# "dev" enables auto-reload and the /docs OpenAPI UI. Anything else = production-safe.
ENV=prod

# Optional: uvicorn bind address/port (run.py). Defaults: 127.0.0.1:8000.
# HOST=127.0.0.1
# PORT=8000

# ── Anthropic API ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail ────────────────────────────────────────────────────────────────
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── CallMeBot WhatsApp ───────────────────────────────────────────────────
CALLMEBOT_PHONE=+521234567890
CALLMEBOT_APIKEY=TU_API_KEY_AQUI
