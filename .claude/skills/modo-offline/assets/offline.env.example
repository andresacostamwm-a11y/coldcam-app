# Modo offline — copia esto a .env.offline y cargalo con:  source .env.offline
#
# Con estas variables, Claude Code y el SDK `anthropic` de app/main.py hablan con
# el gateway local en vez de con api.anthropic.com.

# ── Cliente (Claude Code, SDK anthropic) ──────────────────────────────────────
export ANTHROPIC_BASE_URL=http://127.0.0.1:8787
export ANTHROPIC_API_KEY=offline          # el gateway no la valida, los SDK la exigen

# ── Gateway ───────────────────────────────────────────────────────────────────
export OFFLINE_GATEWAY_HOST=127.0.0.1
export OFFLINE_GATEWAY_PORT=8787
export OFFLINE_GATEWAY_VERBOSE=1          # 0 para silenciarlo

# ── Backend de modelo local ───────────────────────────────────────────────────
export OLLAMA_HOST=http://127.0.0.1:11434
export OFFLINE_MODEL=qwen2.5-coder:7b

# Mapeo opcional por tier: nombre de modelo Claude -> modelo local
# export OFFLINE_MODEL_MAP='{"claude-opus-5":"qwen2.5-coder:32b","claude-haiku-4-5-20251001":"qwen2.5-coder:7b"}'

# ── Cola de tareas ────────────────────────────────────────────────────────────
# export OFFLINE_QUEUE_PATH=.offline/queue.json

# ── Recordatorio ──────────────────────────────────────────────────────────────
# El proxy del sistema no debe interceptar localhost:
# export NO_PROXY="localhost,127.0.0.1,::1,${NO_PROXY:-}"
