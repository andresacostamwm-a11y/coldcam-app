{
  "mcpServers": {
    "n8n": {
      "command": "n8n-mcp",
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "N8N_API_URL": "http://localhost:5678/api/v1",
        "N8N_API_KEY": "n8n_api_paste_your_key_here"
      },
      "disabled": false
    }
  },
  "extraKnownMarketplaces": {
    "modo-tdah": {
      "source": {
        "source": "github",
        "repo": "Hainrixz/modo-tdah"
      }
    }
  },
  "enabledPlugins": {
    "modo-tdah@modo-tdah": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/tdah-contexto.md 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Recuperando contexto..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Hoy es $(date '+%A %d/%m/%Y'), hora local $(date '+%H:%M')\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/skills/tdah-recordatorios/scripts/recordatorios.py check 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
